ARG BASE_IMAGE

# Using https://openzfs.github.io/openzfs-docs/Developer%20Resources/Custom%20Packages.html
FROM ${BASE_IMAGE} AS builder-zfs

ARG VERSION_ZFS
ARG CHECKSUMS_ZFS

# Install build depdendencies
RUN <<EOT
  set -euxo pipefail

  # Get the kernel version
  # We can't use `uname -r` as it will pick up the host kernel version
  VERSION_KERNEL=$(rpm -qa kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')

  dnf install -y \
    jq make autoconf automake gcc libtool rpm-build libblkid-devel \
    libuuid-devel libudev-devel openssl-devel zlib-devel libaio-devel libattr-devel elfutils-libelf-devel \
    kernel-${VERSION_KERNEL} kernel-modules-${VERSION_KERNEL} \
    python3 python3-devel python3-setuptools python3-packaging python3-cffi libffi-devel git libcurl-devel
EOT

# Install kernel-devel and kernel-devel-matched, matching the kernel of the base image
RUN <<EOT
  set -euxo pipefail

  VERSION_KERNEL=$(rpm -qa kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')

  # Installs one subpackage of the kernel already in this image, at that exact build, when it is no longer in the enabled repositories
  # CentOS Stream mirrors only carry the packages of the last few composes, and AlmaLinux drops superseded builds from its repository metadata
  # Both keep the RPMs themselves, so fall back to the archive that holds them
  install_kernel_package_from_archive() {
    PKG="$1"
    KERNEL_ARCH=$(rpm -qa kernel --queryformat '%{ARCH}')
    OS_ID=$(grep -oP '(?<=^ID=).+' /etc/os-release | tr -d '"')
    OS_VERSION_ID=$(grep -oP '(?<=^VERSION_ID=).+' /etc/os-release | tr -d '"')

    URLS=""
    case "${OS_ID}" in
      centos)
        # Koji keeps every build forever, including a copy signed with the same key that signed the kernel already installed here, under data/signed/<short key id>/
        KERNEL_NV=$(rpm -qa kernel --queryformat '%{VERSION}/%{RELEASE}')
        KERNEL_KEY=$(rpm -qa kernel --queryformat '%{RSAHEADER:pgpsig}' \
          | sed -nE 's/.*[Kk]ey ID [0-9a-fA-F]{8}([0-9a-fA-F]{8}).*/\1/p')
        URLS="https://kojihub.stream.centos.org/kojifiles/packages/kernel/${KERNEL_NV}/data/signed/${KERNEL_KEY}/${KERNEL_ARCH}/${PKG}-${VERSION_KERNEL}.rpm"
        ;;
      almalinux)
        # The kernel packages are in BaseOS and the kernel-devel ones in AppStream, so try both rather than map each package to its repository
        # The release this image is from is in the main tree until it is superseded, and in the vault from then on
        for TREE in "almalinux/${OS_VERSION_ID}" "vault/${OS_VERSION_ID}"; do
          for REPO in BaseOS AppStream; do
            URLS="${URLS} https://repo.almalinux.org/${TREE}/${REPO}/${KERNEL_ARCH}/os/Packages/${PKG}-${VERSION_KERNEL}.rpm"
          done
        done
        ;;
      *)
        echo "There is no archive to download ${PKG}-${VERSION_KERNEL} from for ${OS_ID}" >&2
        return 1
        ;;
    esac

    for URL in ${URLS}; do
      curl -fsSL -o /tmp/${PKG}.rpm "${URL}" || continue
      # Fails unless the package is signed with a key rpm already trusts
      rpm --checksig /tmp/${PKG}.rpm
      dnf install -y /tmp/${PKG}.rpm
      rm -f /tmp/${PKG}.rpm
      return 0
    done

    echo "Package ${PKG}-${VERSION_KERNEL} is not in the enabled repositories, nor in the archive of ${OS_ID} ${OS_VERSION_ID}" >&2
    return 1
  }

  # Both must match the kernel in the base image exactly, and that exact build is frequently not in the enabled repositories (e.g. the image ships 5.14.0-730.el9 while the repositories have 742)
  # kernel-devel-matched is here because dkms, installed in the next step, depends on it
  # Left to dnf there, it comes in at the newest version, which requires - and so upgrades to - a newer kernel, and ZFS ends up built for a kernel that isn't in the image
  for PKG in kernel-devel kernel-devel-matched; do
    dnf install -y ${PKG}-${VERSION_KERNEL} || install_kernel_package_from_archive ${PKG}
  done
EOT

RUN <<EOT
  set -euxo pipefail

  CRB_REPO_NAME=""
  case $(grep -oP '(?<=^ID=).+' /etc/os-release | tr -d '"') in
    rhel) CRB_REPO_NAME="codeready-builder-for-rhel-9-$(arch)-rpms" ;;
    *) CRB_REPO_NAME="crb" ;;
  esac
  dnf install -y --enablerepo=epel --enablerepo=$CRB_REPO_NAME \
    dkms libtirpc-devel ncompress
EOT

RUN <<EOT
  set -euxo pipefail

  VERSION_KERNEL=$(rpm -qa kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')

  curl -L -O https://github.com/openzfs/zfs/releases/download/zfs-${VERSION_ZFS}/zfs-${VERSION_ZFS}.tar.gz
  echo "${CHECKSUMS_ZFS}" | sha256sum --check --status

  tar xzf zfs-${VERSION_ZFS}.tar.gz
  mv zfs-${VERSION_ZFS} zfs

  cd /zfs
  ./configure -with-linux=/usr/src/kernels/${VERSION_KERNEL}/ -with-linux-obj=/usr/src/kernels/${VERSION_KERNEL}/
  make -j1 rpm-utils rpm-kmod
  ls -al /zfs/*.rpm
EOT
