COPY --from=builder-zfs /zfs/*.rpm /zfs/
RUN <<EOT
  set -euxo pipefail

  # ZFS
  # We install a bunch of RPMs, probably more than needed
  rm \
    /zfs/*devel*.rpm \
    /zfs/zfs-test*.rpm
  dnf install -y \
    /zfs/*.$(rpm -qa kernel --queryformat '%{ARCH}').rpm
  # Auto-load ZFS module
  VERSION_KERNEL=$(rpm -qa kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}')
  depmod -a "${VERSION_KERNEL}"

  # The kmod RPM has no dependency on the kernel it was built for: it only drops the module in /lib/modules/<the version it was built for>/extra, so it installs cleanly even when a layer added earlier upgraded the kernel, and the mismatch would surface only as a "module zfs not found" on the booted host.
  if ! modinfo -k "${VERSION_KERNEL}" zfs >/dev/null; then
    echo "The ZFS module was not built for ${VERSION_KERNEL}, the kernel in this image. /lib/modules contains:" >&2
    ls -1 /lib/modules >&2
    exit 1
  fi

  echo "zfs" > /etc/modules-load.d/zfs.conf
  # We don't want any files on /var and /zfs
  rm -rf /var/lib/pcp /zfs

  # Add hdparm, sdparm, smartmontools
  dnf install -y hdparm sdparm smartmontools

  # Clean-up
  dnf clean all
EOT
